#!/usr/bin/env bash
# OpenRouter Tracker Git Pre-Push Hook
# Runs before code is pushed to remote.
# Ensures full test suite passes and project compiles cleanly.

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}==> [pre-push] Verifying unit test suite and project integrity...${NC}"

if [ -f "scripts/run_tests.sh" ]; then
    bash scripts/run_tests.sh
    echo -e "${GREEN}✓ Pre-push test verification passed.${NC}"
fi

exit 0
