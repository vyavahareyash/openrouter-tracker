#!/usr/bin/env bash
# OpenRouter Tracker Git Pre-Commit Hook
# Fast local verification gates:
# 1. Secret scanning (detect raw OpenRouter API keys & private keys)
# 2. Swift code lint & style verification (swift format lint)
# 3. Python generator syntax verification (py_compile)
# 4. Fast unit test execution (./scripts/run_tests.sh, ~40ms)

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}==> [pre-commit] Validating local invariants...${NC}"

# ── 1. Secret Scanning ────────────────────────────────────────────────────────
echo -e "${BLUE}--> 1/4 Checking for exposed secrets or API keys...${NC}"
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --verbose
else
    STAGED_SECRETS=$(git diff --cached --pickaxe-regex -S'sk-or-v1-[a-f0-9]{32,}' -- ':(exclude).githooks/*' ':(exclude)Tests/*' ':(exclude)docs/*' 2>/dev/null || true)
    if [ -n "$STAGED_SECRETS" ]; then
        echo -e "${RED}Error: Potential real OpenRouter production API key detected in staged changes!${NC}"
        echo "Please remove the secret from staged files and use .env (gitignored)."
        exit 1
    fi

    STAGED_PRIVATE_KEYS=$(git diff --cached --pickaxe-regex -S'-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----' -- ':(exclude).githooks/*' 2>/dev/null || true)
    if [ -n "$STAGED_PRIVATE_KEYS" ]; then
        echo -e "${RED}Error: Potential private key detected in staged changes!${NC}"
        exit 1
    fi
fi
echo -e "${GREEN}✓ Secrets scan clean.${NC}"

# ── 2. Swift Lint / Code Formatting ───────────────────────────────────────────
echo -e "${BLUE}--> 2/4 Checking Swift code style & formatting...${NC}"
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$' || true)

if [ -n "$STAGED_SWIFT_FILES" ]; then
    if command -v swift >/dev/null 2>&1 && swift format --help >/dev/null 2>&1; then
        CFG_ARG=""
        if [ -f ".swift-format" ]; then
            CFG_ARG="--configuration .swift-format"
        fi
        
        # Check if files need formatting
        UNFORMATTED=0
        for file in $STAGED_SWIFT_FILES; do
            if [ -f "$file" ]; then
                if ! swift format lint $CFG_ARG "$file" >/dev/null 2>&1; then
                    echo -e "${YELLOW}Notice: Formatting style suggestions in $file${NC}"
                    UNFORMATTED=$((UNFORMATTED + 1))
                fi
            fi
        done
        
        if [ $UNFORMATTED -gt 0 ]; then
            echo -e "${YELLOW}Tip: Auto-format with: swift format format -i --configuration .swift-format <files>${NC}"
        fi
    fi
fi
echo -e "${GREEN}✓ Swift lint check complete.${NC}"

# ── 3. Script Syntax Verification ─────────────────────────────────────────────
echo -e "${BLUE}--> 3/4 Verifying Python generator scripts...${NC}"
python3 -m py_compile generate_project.py
echo -e "${GREEN}✓ Python scripts valid.${NC}"

# ── 4. Unit Test Verification ─────────────────────────────────────────────────
echo -e "${BLUE}--> 4/4 Running fast unit tests...${NC}"
if [ -f "scripts/run_tests.sh" ]; then
    bash scripts/run_tests.sh >/dev/null 2>&1
    echo -e "${GREEN}✓ All unit tests passed.${NC}"
fi

echo -e "${GREEN}==> All pre-commit checks passed successfully!${NC}"
exit 0
